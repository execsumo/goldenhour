# 🌅 Golden Hour Configuration Overrides
# Copy this file to .env to override default application configurations.

# Gemini API Configurations
# Preset API key so users don't have to enter one in Settings (a key entered
# there still takes precedence). WARNING: VITE_* values are compiled into the
# client bundle, so anyone who can load the app can read this key.
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VITE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# VITE_GEMINI_TEXT_MODEL=gemini-3-flash-preview

# ComfyUI Default Connection (prefills Settings; setting a host without a Gemini
# key also makes ComfyUI the default backend). Include https:// for HTTPS endpoints;
# HTTPS defaults to port 443, while plain hosts default to 8188.
# Remote hosts are proxied through the Vite dev/preview server.
# VITE_COMFYUI_HOST=127.0.0.1
# VITE_COMFYUI_PORT=8188
# Example HTTPS endpoint:
# VITE_COMFYUI_HOST=https://comfyui.example.ts.net
# VITE_COMFYUI_PORT=443
